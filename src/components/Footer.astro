---
import Icon from './Icon.astro'

const currentYear = new Date().getFullYear()
---

<footer>
  <div class='group'>
    <p>
      Developed with <a href='https://astro.build/'>Astro</a>
      <Icon icon='rocket-launch' size='1.2em' /> by <a
        href='https://danellewessels.com'>Dan</a
      >
    </p>
    <p>&copy; {currentYear} Jose Antonio González Rodríguez</p>
    <p>
      <a
        href='https://thenounproject.com/icon/art-deco-pattern-3292234/'
        target='_blank'
        title='art deco Icons'>Noun Project pattern</a
      > by Olena Panasovska
    </p>
  </div>
</footer>
<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    border-top: 1px solid var(--gray-800);
    margin-top: 5rem;
    padding: 3rem 2rem 3rem;
    text-align: center;
    color: var(--gray-400);
    font-size: var(--text-sm);
  }

  footer a {
    color: var(--gray-400);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  footer a:hover,
  footer a:focus {
    text-decoration-color: currentColor;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (min-width: 50em) {
    footer {
      flex-direction: row;
      justify-content: space-between;
      padding: 2.5rem 5rem;
    }

    .group {
      flex-direction: row;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .socials {
      justify-content: flex-end;
    }
  }
</style>
