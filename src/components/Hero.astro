---
interface Props {
  title: string
  tagline?: string
}

const { tagline, title } = Astro.props
---

<div style={{ height: '50vh', minHeight: '35rem' }}>
  <div
    class='stack gap-4'
    style={{ position: 'absolute', left: 0, maxWidth: '100vw' }}
  >
    <div class='hero-info-container'>
      <div
        class='decorative-hero-bg-container'
        aria-hidden='true'
        style={{
          position: 'absolute',
          top: '-1rem',
          right: '-1rem',
          bottom: '-1rem',
          left: 0,
          backgroundColor: '#F1E8E1'
        }}
      >
      </div>
      <div
        class='decorative-hero-bg-container profile-img-container'
        aria-hidden='true'
      >
        <div
          style={{
            position: 'absolute',
            top: '0.8rem',
            bottom: 0,
            left: 0,
            right: '7rem',

            opacity: 0.5
          }}
        >
          {
            Array.from({ length: 16 }).map((_, i) => (
              <hr
                style={{
                  borderBottom: '1px solid #a9978f',
                  marginBottom: '0.7rem'
                }}
              />
            ))
          }
        </div>
        <img
          alt='Jose Antonio González Rodríguez portrait photo'
          width='200'
          src='/assets/portrait.jpg'
          class='hero-image'
        />
      </div>
      <div
        class='decorative-hero-bg-container'
        aria-hidden='true'
        style={{ zIndex: 2, position: 'relative' }}
      >
        <div class='decorative-hero-container white-on-blue'>
          <h1
            class='title'
            style={{
              fontFamily: 'var(--font-brand)',
              maxWidth: '18ch',
              color: '#F1E8E1'
            }}
          >
            {title}
          </h1>
        </div>
      </div>
    </div>

    <div
      class='decorative-hero-bg-container'
      aria-hidden='true'
      style={{ marginRight: 'auto', zIndex: 2 }}
    >
      <div class='decorative-hero-container blue-on-white'>
        {tagline && <p class='tagline'>{tagline}</p>}
      </div>
    </div>
  </div>
  <slot />
</div>

<style>
  .profile-img-container {
    margin: 8.9rem -15rem -5rem 0;
    background-color: #795f42 !important;
    z-index: 1;
    overflow: hidden;
    position: absolute;
    top: 0;
    left: 0;
    right: 1rem;
  }

  .hero {
    font-size: var(--text-lg);
    text-align: center;
  }

  .hero-info-container {
    z-index: 2;
    position: relative;
    margin-inline-end: 8rem;
  }

  .hero-image {
    border-radius: 100%;
    float: right;
    border: 3px solid #a9978f;
    position: relative;
    z-index: 2;
  }

  .decorative-hero-container {
    border-radius: 0 50vh 50vh 0;
    border: 3px solid #a9978f;
    border-left: none;
  }

  .white-on-blue {
    background-color: #15232b;
    color: #f1e8e1;
  }

  .blue-on-white {
    background-color: #f1e8e1;
    color: #15232b;
  }

  .decorative-hero-bg-container {
    border-radius: 0 50vh 50vh 0;
    border: 3px solid #a9978f;
    border-left: none;
    background-color: #2c475a;
    padding: 0.8rem;
    padding-left: 0;
    max-width: 100vw;
    /* margin-top: 10rem; */
    margin-bottom: 6rem;
  }

  .tagline {
    width: 37ch;
    max-width: 80vw;
    font-size: 1rem;
    line-height: 1.2;
    font-weight: 400;
    color: #2c475a;
    padding: 1rem 4rem 1rem 1.2rem;
  }

  .title {
    font-size: var(--text-2xl);
    color: var(--gray-0);
    padding: 1.2rem;
    padding-right: 2rem;
  }

  .start {
    text-align: start;
  }

  @media (min-width: 28em) {
    .tagline {
      max-width: 50vw;
    }

    .decorative-hero-bg-container {
      border-radius: 0 50vh 50vh 0;
      border: 3px solid #a9978f;
      border-left: none;
      background-color: #2c475a;
      padding: 0.8rem;
      padding-left: 0;
      max-width: 100vw;
      margin-bottom: 0;
    }
  }

  @media (min-width: 50em) {
    .hero-info-container {
      margin-inline-end: 15rem;
    }

    .title,
    .tagline {
      margin-inline-start: 2rem;
    }

    .title {
      font-size: var(--text-4xl);
      padding: 1.7rem;
    }

    .tagline {
      font-size: 1.1rem;
    }
  }

  @media (min-width: 80em) {
    .title,
    .tagline {
      margin-inline-start: 4rem;
    }

    .title {
      font-size: var(--text-5xl);
      padding: 2rem;
    }

    .tagline {
      font-size: 1.2rem;
    }
  }
</style>
