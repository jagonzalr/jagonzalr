---
interface Props {
  title: string
  tagline?: string
}

const { tagline, title } = Astro.props
---

<div style={{ height: '50vh', minHeight: '35rem' }}>
  <div
    class='stack gap-4'
    style={{ position: 'absolute', left: 0, maxWidth: '100vw' }}
  >
    <div style={{ zIndex: 2, position: 'relative', marginInlineEnd: '16rem' }}>
      <div
        class='decorative-hero-bg-container'
        aria-hidden='true'
        style={{
          zIndex: 1,
          position: 'absolute',
          top: '-1rem',
          right: '-1rem',
          bottom: '-1rem',
          left: 0,
          backgroundColor: '#F1E8E1'
        }}
      >
      </div>
      <div
        class='decorative-hero-bg-container'
        aria-hidden='true'
        style={{
          margin: '8.9rem -15rem -5rem 0',
          backgroundColor: '#795F42',
          zIndex: 1,
          overflow: 'hidden',
          position: 'absolute',
          top: 0,
          left: 0,
          right: '1rem'
        }}
      >
        <div
          style={{
            position: 'absolute',
            top: '0.8rem',
            bottom: 0,
            left: 0,
            right: '7rem',
            zIndex: 1,
            opacity: 0.5
          }}
        >
          {
            Array.from({ length: 16 }).map((_, i) => (
              <hr
                style={{
                  borderBottom: '1px solid #a9978f',
                  marginBottom: '0.7rem'
                }}
              />
            ))
          }
        </div>
        <img
          alt='Jose Antonio González Rodríguez portrait photo'
          width='200'
          src='/assets/portrait.jpg'
          class='hero-image'
        />
      </div>
      <div
        class='decorative-hero-bg-container'
        aria-hidden='true'
        style={{ zIndex: 2, position: 'relative' }}
      >
        <div
          class='decorative-hero-container white-on-blue'
          style={{ padding: '2rem' }}
        >
          <h1
            class='title'
            style={{
              fontFamily: 'var(--font-brand)',
              maxWidth: '18ch',
              color: '#F1E8E1'
            }}
          >
            {title}
          </h1>
        </div>
      </div>
    </div>

    <div
      class='decorative-hero-bg-container'
      aria-hidden='true'
      style={{ marginRight: 'auto', zIndex: 2 }}
    >
      <div
        class='decorative-hero-container blue-on-white'
        style={{
          padding: '1.2rem 4rem 1.2rem 2rem'
        }}
      >
        {tagline && <p class='tagline'>{tagline}</p>}
      </div>
    </div>
  </div>
  <slot />
</div>

<style>
  .hero {
    font-size: var(--text-lg);
    text-align: center;
  }

  .hero-image {
    border-radius: 100%;
    float: right;
    border: 3px solid #a9978f;
    position: relative;
    z-index: 2;
  }

  .decorative-hero-container {
    border-radius: 0 50vh 50vh 0;
    border: 3px solid #a9978f;
    border-left: none;
  }

  .white-on-blue {
    background-color: #15232b;
    color: #f1e8e1;
  }

  .blue-on-white {
    background-color: #f1e8e1;
    color: #15232b;
  }

  .decorative-hero-bg-container {
    border-radius: 0 50vh 50vh 0;
    border: 3px solid #a9978f;
    border-left: none;
    background-color: #2c475a;
    padding: 0.8rem;
    padding-left: 0;
  }

  .tagline {
    width: 37ch;
    max-width: 50vw;
    font-size: 1.1rem;
    line-height: 1.3;
    font-weight: 500;
  }

  .title {
    font-size: var(--text-3xl);
    color: var(--gray-0);
  }

  .start {
    text-align: start;
  }

  @media (min-width: 50em) {
    .title,
    .tagline {
      margin-inline-start: 2rem;
    }

    .title {
      font-size: var(--text-4xl);
    }

    .tagline {
      font-size: 1.2rem;
    }
  }

  @media (min-width: 80em) {
    .title,
    .tagline {
      margin-inline-start: 4rem;
    }

    .title {
      font-size: var(--text-5xl);
    }
  }
</style>
