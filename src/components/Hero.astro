---
interface Props {
  title: string
  tagline?: string
}

const { tagline, title } = Astro.props
---

<div class='hero-position-container'>
  <div
    class='stack gap-4'
    style={{ position: 'absolute', left: '0', maxWidth: '100vw' }}
  >
    <div class='hero-info-container'>
      <div
        class='decorative-hero-bg-container'
        aria-hidden='true'
        style={{
          position: 'absolute',
          top: '-1rem',
          right: '-1rem',
          bottom: '-1rem',
          left: 0,
          backgroundColor: '#F1E8E1'
        }}
      >
      </div>
      <div
        class='decorative-hero-bg-container profile-img-container'
        aria-hidden='true'
      >
        <div
          style={{
            position: 'absolute',
            top: '0.8rem',
            bottom: 0,
            left: 0,
            right: '9rem',
            opacity: 0.5
          }}
        >
          {
            Array.from({ length: 22 }).map((_, i) => (
              <hr
                style={{
                  borderBottom: '1px solid #a9978f',
                  marginBottom: '0.7rem'
                }}
              />
            ))
          }
        </div>
        <img
          alt='Jose Antonio González Rodríguez portrait photo'
          width='280'
          src='/assets/portrait.jpg'
          class='hero-image'
        />
      </div>
      <div
        class='decorative-hero-bg-container'
        aria-hidden='true'
        style={{
          zIndex: 2,
          position: 'relative'
        }}
      >
        <div class='decorative-hero-container white-on-blue'>
          <h1
            class='title'
            style={{
              maxWidth: '18ch',
              color: '#F1E8E1'
            }}
          >
            {title}
          </h1>
        </div>
      </div>
    </div>
    <div
      class='decorative-hero-bg-container'
      aria-hidden='true'
      style={{ marginRight: 'auto', zIndex: 2, minWidth: '30rem' }}
    >
      <div class='decorative-hero-container blue-on-white'>
        {tagline && <p class='tagline'>{tagline}</p>}
      </div>
    </div>
    <slot />
  </div>

  <style>
    .profile-img-container {
      margin: 6rem -19rem 0 0;
      background-color: #795f42 !important;
      overflow: hidden;
      position: absolute;
      top: 0;
      left: 0;
      right: 1rem;
    }

    .hero-position-container {
      height: 30vh;
      min-height: 20rem;
      scale: 0.5;
      transform-origin: left center;
      width: 100%;
    }

    .hero-info-container {
      z-index: 2;
      position: relative;
      margin-bottom: 2rem;
    }

    .hero-image {
      border-radius: 100%;
      float: right;
      border: 3px solid var(--accent-light);
      position: relative;
      z-index: 100;
      width: 250px;
    }

    .decorative-hero-container {
      border-radius: 0 50vh 50vh 0;
      border: 3px solid var(--accent-light);
      border-left: none;
    }

    .white-on-blue {
      background-color: #15232b;
      color: #f1e8e1;
      background: linear-gradient(to right bottom, #0c161c, #15232b, #626154);
    }

    .blue-on-white {
      background-color: #f1e8e1;
      color: #15232b;
    }

    .decorative-hero-bg-container {
      border-radius: 0 50vh 50vh 0;
      border: 3px solid var(--accent-light);
      border-left: none;
      background-color: #2c475a;
      padding: 0.8rem;
      padding-left: 0;
    }

    .tagline {
      width: 100%;
      max-width: 35ch;
      font-size: 1.6rem;
      line-height: 1.4;
      color: #1d2b35;
      padding: 1.5rem 2.5rem 1.5rem 2rem;
      font-family: 'Google Sans Flex', serif;
      font-weight: 400;
    }

    .title {
      font-size: var(--text-3xl);
      color: var(--gray-0);
      padding: 2rem;
      padding-right: 4rem;
    }

    .start {
      text-align: start;
    }

    @media (min-width: 22em) {
      .hero-position-container {
        scale: 0.6;
      }
    }

    @media (min-width: 28em) {
      .title {
        font-size: var(--text-4xl);
      }

      .hero-info-container {
        margin-bottom: 0;
      }

      .decorative-hero-bg-container {
        margin-bottom: 0;
      }

      .hero-image {
        width: 280px;
      }

      .profile-img-container {
        margin: 6rem -19rem 0 0;
      }

      .hero-position-container {
        scale: 0.7;
      }
    }

    @media (min-width: 50em) {
      .title {
        font-size: var(--text-4xl);
      }

      /* .profile-img-container {
        margin: 6rem -19rem 0 0;
      } */

      .profile-img-container {
        /* margin: 6rem -19px 0 0; */
      }

      .hero-info-container {
        margin-inline-end: 15rem;
        /* margin-bottom: 0; */
      }

      .title,
      .tagline {
        margin-inline-start: 2rem;
      }

      .title {
        /* font-size: var(--text-4xl); */
        padding: 1.7rem;
      }

      .tagline {
        font-size: 1.4rem;
        /* font-size: 1.3rem; */
      }

      .hero-position-container {
        scale: 0.8;
      }
    }

    @media (min-width: 80em) {
      .title,
      .tagline {
        margin-inline-start: 4rem;
      }

      .title {
        padding: 2rem 4rem 2rem 0;
      }

      .tagline {
        padding-left: 0rem;
      }

      .hero-position-container {
        scale: 1;
      }
    }
  </style>
</div>
