---
import type { CollectionEntry } from 'astro:content'
import ArtDecoPattern from '../images/art-deco-pattern.svg'

interface Props {
  project: CollectionEntry<'work'>
}

const { data, id } = Astro.props.project

const rowCount = 2
const colCount = 4
---

<a class='card' href={`/work/${id}`}>
  <span class='title'>{data.title}</span>
  <span class='subtitle'>{data.description}</span>
  <div class='overlay'></div>
  <div class='pattern-container'>
    {
      Array.from({ length: rowCount }).map((_, index) => (
        <div
          style={{
            marginBottom: '-28px',
            marginTop: '-8px',
            transform: index % 2 === 0 ? 'translateX(-48px)' : 'none'
          }}
        >
          {Array.from({ length: colCount }).map(() => (
            <ArtDecoPattern
              width={200}
              height={210}
              fill='black'
              style={{ marginLeft: '-3px', display: 'inline-block' }}
            />
          ))}
        </div>
      ))
    }
  </div>
</a>

<style>
  .pattern-container {
    white-space: nowrap;
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.3;
    overflow: hidden;
  }

  .overlay {
    position: absolute;
    background-image: linear-gradient(
      to bottom right,
      rgb(82, 97, 120),
      rgb(8, 20, 30)
    );
    opacity: 0.9;
    z-index: 0;
    height: 100%;
    width: 100%;
  }

  .card {
    cursor: pointer;
    display: block;
    position: relative;
    height: 100%;
    width: 100%;
    text-decoration: none;
    font-family: var(--font-brand);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .card:hover {
    background-color: #c4a06e;
  }

  .title {
    z-index: 1;
    position: absolute;
    top: 20%;
    min-width: 50%;
    padding: 0.5rem 2rem 0.5rem 1.5rem;
    background: #15232b;
    color: #e2d7c1;
    border-radius: 0 4rem 4rem 0;
    font-size: 3rem;
    border: 3px solid #c4a06e;
    border-left: none;
  }

  .subtitle {
    z-index: 1;
    position: absolute;
    text-align: right;
    top: 60%;
    right: 0;
    width: 70%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 30%;
    padding: 0.5rem 1.5rem;
    background: #15232b;
    color: #e2d7c1;
    border-radius: 4rem 0 0 4rem;
    font-size: large;
    line-height: 1.4rem;
    color: white;
    border: 3px solid #c4a06e;
    border-right: none;
    font-family: 'Google Sans Flex', serif;
    font-weight: 200;
  }

  img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
</style>
