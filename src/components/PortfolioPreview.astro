---
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'work'>
}

const { data, id } = Astro.props.project
---

<a class='card' href={`/work/${id}`}>
  <span class='title'>{data.title}</span>
  <span class='subtitle'>{data.description}</span>
  <img
    src={data.img}
    alt={data.img_alt || ''}
    loading='lazy'
    decoding='async'
  />
</a>

<style>
  .card {
    display: block;
    position: relative;
    height: 100%;
    width: 100%;
    background: var(--gradient-subtle);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    font-family: var(--font-brand);
    font-size: var(--text-lg);
    font-weight: 500;
    transition: box-shadow var(--theme-transition);
  }

  .card:hover {
    box-shadow: var(--shadow-md);
  }

  .title {
    z-index: 1;
    position: absolute;
    top: 20%;
    min-width: 50%;
    padding: 0.5rem 2rem 0.5rem 1.5rem;
    background: #15232b;
    color: #e2d7c1;
    border-radius: 0 4rem 4rem 0;
    font-size: 3rem;
    border: 3px solid #c4a06e;
    border-left: none;
  }

  .subtitle {
    z-index: 1;
    position: absolute;
    top: 60%;
    right: 0;
    width: 70%;
    display: flex;
    align-items: center;
    min-height: 30%;
    padding: 0.5rem 1.5rem;
    background: #15232b;
    color: #e2d7c1;
    border-radius: 4rem 0 0 4rem;
    font-size: large;
    line-height: 1.3rem;
    color: white;
    border: 3px solid #c4a06e;
    border-right: none;
    font-family:
      Poiret One,
      serif;
  }

  img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  @media (min-width: 50em) {
    .card {
      /* height: 22rem; */
      /* border: 3px solid #c4a06e; */
      /* border-radius: 1.5rem; */
    }

    .title {
      /* border-radius: 0.9375rem 0; */
    }
  }
</style>
