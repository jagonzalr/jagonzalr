---
import { getCollection } from 'astro:content'
// Component Imports
import CallToAction from '../components/CallToAction.astro'
// Page section components
import ContactCTA from '../components/ContactCTA.astro'
import Hero from '../components/Hero.astro'
import Icon from '../components/Icon.astro'
import PortfolioPreview from '../components/PortfolioPreview.astro'
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro'

// Content Fetching: List four most recent work projects
const projects = (await getCollection('work'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3)

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
  <div class='stack gap-20 lg:gap-48'>
    <div class='gap-8 lg:gap-20 background-image'>
      <header class='hero'>
        <Hero
          title='Jose Antonio González Rodríguez'
          tagline='Mexican living in Porto working at SoSafe, the leading human risk management platform. I enjoy 🌶️ food, reading Sci-Fi / Fantasy 📚, playing action/adventure / RPG 🕹️, 🏊‍♂️ and Andor.'
        />
      </header>
    </div>

    <main class='wrapper stack gap-20 lg:gap-48'>
      <section class='section'>
        <div class='background-image-featured' style={{ position: 'relative' }}>
          <div class='decor-frame'></div>
          <div class='decor-frame-alt'></div>
          <header class='section-header stack gap-2 lg:gap-4'>
            <h3>Featured Projects</h3>
          </header>
        </div>
        <div }}>
          <div class='gallery'>
            {
              projects.map(project => (
                <li>
                  <PortfolioPreview project={project} />
                </li>
              ))
            }
          </div>
          <div class='cta'>
            <CallToAction href='/work/'>
              View All
              <Icon icon='arrow-right' size='1.2em' />
            </CallToAction>
          </div>
        </div>
      </section>
      <ContactCTA />
    </main>
  </div>

  <style>
    .wrapper {
      max-width: 120rem;
      padding-inline: 5%;
    }

    .hero {
      height: 100vh;
      display: grid;
      align-items: end;
      gap: 2rem;
    }

    .roles {
      display: none;
    }

    .hero img {
      aspect-ratio: 5 / 4;
      object-fit: cover;
      object-position: top;
      border-radius: 1.5rem;
      box-shadow: var(--shadow-md);
    }

    .decor-frame {
      position: absolute;
      top: -20px;
      left: 0;
      right: -20px;
      bottom: 0;
      border: 3px solid #c4a06e;
    }

    .decor-frame-alt {
      position: absolute;
      top: 0;
      right: 0;
      left: -20px;
      bottom: -20px;
      border: 3px solid #c4a06e;
    }

    @media (min-width: 50em) {
      .roles {
        margin-top: 0.5rem;
        display: flex;
        gap: 0.5rem;
      }

      .hero img {
        aspect-ratio: 3 / 4;
        border-radius: 4.5rem;
        object-fit: cover;
      }
    }

    /* ====================================================== */
    .background-image {
      min-height: 20rem;
      height: 100vh;
      background: var(--bg-image-main) top center;
      background-size: cover;
    }

    .background-image-featured {
      margin-top: 1.3rem;
      min-height: 50rem;
      height: 85vh;
      max-height: 75rem;
      background: var(--bg-image-featured) top center;
      background-size: cover;
    }

    .background-image-projects {
      min-height: 20rem;
      background: var(--bg-image-projects) top center;
      background-size: cover;
    }

    .section {
      display: grid;
      gap: 2rem;
    }

    .section-header {
      justify-self: center;
      text-align: center;
      max-width: 50ch;
      font-size: var(--text-md);
      color: var(--gray-300);
    }

    .section-header h3 {
      font-size: var(--text-2xl);
      color: #15232b;
      padding: 4rem;
      font-size: var(--text-4xl);
    }

    .gallery {
      height: calc(85vh - 6rem);
      min-height: 50rem;
      max-height: 70rem;
      margin-bottom: 2rem;
      display: flex;
      gap: 1.5rem;
      flex-direction: column;
    }

    .gallery > li {
      list-style-type: none;
      flex-grow: 1;
    }

    @media (min-width: 50em) {
      .section {
        grid-template-columns: 1fr 1fr;
        grid-template-areas: 'header header' 'gallery gallery';
        gap: 5rem;
      }

      .section-header {
        grid-area: header;
        font-size: var(--text-lg);
      }

      .section-header h3 {
        font-size: var(--text-5xl);
      }

      .cta {
        grid-area: cta;
      }
    }

    /* ====================================================== */

    .mention-card {
      display: flex;
      height: 7rem;
      justify-content: center;
      align-items: center;
      text-align: center;
      border: 1px solid var(--gray-800);
      border-radius: 1.5rem;
      color: var(--gray-300);
      background: var(--gradient-subtle);
      box-shadow: var(--shadow-sm);
    }

    @media (min-width: 50em) {
      .mention-card {
        border-radius: 1.5rem;
        height: 9.5rem;
      }
    }
  </style>
</BaseLayout>
